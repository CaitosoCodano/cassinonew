# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled-in copy.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Generate with: bin/rails secret
SECRET_KEY_BASE=

# Public origin of the deployment. Used for cookie scope and the links inside
# verification emails, so it must match the address players actually visit.
WEB_CLIENT_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
#
# Development uses SQLite out of the box. Production points at PostgreSQL:
#   DATABASE_URL=postgres://user:password@host:5432/luminara

# --- Cache and queue --------------------------------------------------------

# Required in production. Development falls back to a null store.
# REDIS_URL=redis://localhost:6379/0

# --- First administrator ----------------------------------------------------
#
# Only used by `bin/rails db:seed` to create the initial admin. The password
# must be at least 12 characters. Change it after first login.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Play money -------------------------------------------------------------

# Credit granted to a brand-new account, in minor units (100000 = 1,000.00).
# Set to 0 to disable. Posted to the ledger, so it shows up in history.
WELCOME_BONUS_MINOR=100000

# Currency code for the virtual wallet.
PLAY_MONEY_CURRENCY=VCR

# --- Game emergency kill switches --------------------------------------------
#
# These override the admin panel. Set to 1 to stop the feature immediately
# without a deploy.
GAMES_DISABLE_BUY_BONUS=
GAMES_DISABLE_FREE_SPINS=

# Spins used by the RTP Monte Carlo simulation in the admin area.
# GAMES_RTP_SIM_SPINS=40000

# --- Mail -------------------------------------------------------------------
#
# Without SMTP_HOST the verification email is written to backend/tmp/mails/
# instead of being sent, so nothing is lost silently during development.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_DOMAIN=

# --- Real money -------------------------------------------------------------
#
# Leave false unless a licensed payment integration is in place. Deposits and
# withdrawals return 501 while this is false.
REAL_MONEY_ENABLED=false

# --- CORS -------------------------------------------------------------------
#
# Only needed when the client is served from a different origin than the API.
# In the normal single-origin deployment this stays empty.
# CORS_ALLOWED_ORIGINS=