{
  "name": "luminara-web-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web client for the Luminara casino platform foundation. Custom dark/gold design system, no game content.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sfx": "python tools/generate_sfx.py && python tools/generate_music.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}