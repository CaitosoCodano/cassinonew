# ---------------------------------------------------------------------------
# Secrets and local configuration
#
# Nothing in this section may ever be committed. A leaked .env or database file
# hands over the admin account and every session token in the system.
# ---------------------------------------------------------------------------

.env
.env.*
!.env.example
*.env.local

backend/.env
backend/.env.*
!backend/.env.example

# Rails encrypted credentials and keys.
backend/config/master.key
backend/config/credentials/*.key
*.key

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------

# A pattern containing a slash is anchored to the .gitignore's own directory,
# so nested install directories need an explicit `**/` prefix or they get
# committed by accident.
node_modules/
**/node_modules/
vendor/
**/vendor/bundle/
.bundle/
**/.bundle/
.bundle-user/

# ---------------------------------------------------------------------------
# Build output
#
# dist/ is regenerated by `npm run build` on every deploy; committing it just
# creates merge conflicts.
# ---------------------------------------------------------------------------

frontend/dist/
backend/public/assets/
backend/public/sfx/

# ---------------------------------------------------------------------------
# Databases
#
# SQLite files hold real player balances and session tokens.
# ---------------------------------------------------------------------------

*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
backend/storage/*.sqlite3*
backend/db/*.sqlite3*

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
!backend/tmp/pids/
backend/tmp/pids/*
!backend/tmp/pids/.keep
backend/tmp/storage/

# Mail written to disk in development holds verification links with live tokens.
backend/tmp/mails/

# ---------------------------------------------------------------------------
# Generated audio
#
# Reproducible from `npm run sfx`. Large binaries do not belong in history.
# ---------------------------------------------------------------------------

frontend/public/sfx/*.wav

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------

.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Test and coverage artefacts
# ---------------------------------------------------------------------------

coverage/
frontend/coverage/
*.lcov
# GitHub workflows live at the repository root, not inside backend/.
backend/.github/
